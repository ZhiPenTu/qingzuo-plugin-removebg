{
  "name": "@commerce/plugin-removebg",
  "version": "0.1.6",
  "private": true,
  "commerce": {
    "manifestVersion": 1,
    "id": "official.removebg",
    "title": "AI 抠图",
    "description": "连接 remove.bg，生成透明背景的商品图片",
    "category": "图片处理",
    "api": "^1.1.0",
    "ui": "ui/index.html",
    "releaseNotes": "重新设计凭据、操作栏与双预览布局，收紧圆角和间距，支持深色与窄屏。",
    "permissions": {
      "files": true,
      "credentials": [
        "removebg"
      ],
      "network": [
        "https://api.remove.bg"
      ]
    },
    "icon": "data:image/png;base64,"
  },
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "https://github.com/ZhiPenTu/LabelEdit/releases/download/sdk-v1.1.1/commerce-plugin-sdk-1.1.1.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "license": "MIT"
}
